type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserId = principal;
type TribeScoreEntry = 
 record {
   memberCount: nat;
   rank: nat;
   score: float64;
   tribeId: TribeId;
   tribeName: text;
 };
type TribeMemberWithRole = 
 record {
   isLeader: bool;
   userId: text;
   username: text;
 };
type TribeId = text;
type TribeError = 
 variant {
   alreadyMember;
   descriptionTooLong;
   maxTribesReached;
   nameTaken;
   nameTooLong;
   newOwnerMaxTribes;
   newOwnerNoUsername;
   newOwnerNotFound;
   noUsername;
   notFound;
   notMember;
   notOwner;
 };
type Tribe = 
 record {
   coverImageUrl: opt text;
   createdAt: Timestamp;
   cumulativeAkk: nat;
   cumulativeGrit: nat;
   description: text;
   id: TribeId;
   memberCount: nat;
   name: text;
   ownerId: UserId;
   photoUrl: opt text;
 };
type TransformationOutput = 
 record {
   body: blob;
   headers: vec HttpHeader;
   status: nat;
 };
type TransformationInput = 
 record {
   context: blob;
   response: HttpRequestResult;
 };
type Timestamp = int;
type SocialLink = 
 record {
   name: text;
   url: text;
 };
type Result = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type PublicProfile = 
 record {
   bio: text;
   born: text;
   coverImage: text;
   displayName: text;
   evmAddress: opt text;
   hasOgBadge: bool;
   location: text;
   miningStreak: nat;
   playerBadgeLevel: nat;
   profilePicture: text;
   socials: vec SocialLink;
   superpowers: text;
   tribeId: opt text;
   username: text;
 };
type ProfileInput = 
 record {
   bio: text;
   born: text;
   coverImage: text;
   displayName: text;
   evmAddress: opt text;
   location: text;
   profilePicture: text;
   socials: vec SocialLink;
   superpowers: text;
   username: text;
 };
type ProfileError = 
 variant {
   bioTooLong;
   displayNameTooLong;
   locationTooLong;
   socialLinkTooLong;
   superpowersTooLong;
   usernameAlreadyTaken;
   usernameRequired;
   usernameTooLong;
 };
type Profile = 
 record {
   bio: text;
   born: text;
   coverImage: text;
   displayName: text;
   evmAddress: opt text;
   hasOgBadge: bool;
   location: text;
   miningStreak: nat;
   playerBadgeLevel: nat;
   profilePicture: text;
   socials: vec SocialLink;
   superpowers: text;
   username: text;
 };
type PlayerScoreEntry = 
 record {
   displayName: text;
   "principal": principal;
   rank: nat;
   score: float64;
   tribeId: opt TribeId;
   tribeName: text;
   username: text;
 };
type MintRetryView = 
 record {
   amount: nat;
   attempts: nat;
   blockId: nat;
   error: text;
   lastAttemptTime: int;
   minerId: text;
   owner: principal;
 };
type MinerView = 
 record {
   blocksMined: nat;
   createdAt: int;
   gritBalance: nat;
   gritSpent: nat;
   id: MinerId;
   lastProcessedBlock: nat;
   miningRate: nat;
   name: text;
   owner: principal;
   status: MinerStatus;
 };
type MinerStatus = 
 variant {
   active;
   exhausted;
   paused;
 };
type MinerId = nat;
type HttpRequestResult = 
 record {
   body: blob;
   headers: vec HttpHeader;
   status: nat;
 };
type HttpHeader = 
 record {
   name: text;
   value: text;
 };
type ClaimStatus = 
 variant {
   failed;
   pending;
   pendingFee;
   verified;
 };
type ClaimRecord = 
 record {
   amountBurned: float64;
   chain: text;
   claimant: principal;
   feeTxHash: opt text;
   gritMinted: nat;
   status: ClaimStatus;
   timestamp: int;
   tokenAddress: text;
   tokenDecimals: nat;
   tokenSymbol: text;
   txHash: text;
   usdValue: float64;
 };
type ChainFeeEntry = 
 record {
   chain: text;
   feeWei: nat;
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
type BlockRecord = 
 record {
   akkReward: nat;
   blockNumber: nat;
   minerGritSpent: vec record {
                         MinerId;
                         nat;
                       };
   minerParticipants: vec record {
                            MinerId;
                            principal;
                          };
   minerWeights: vec record {
                       MinerId;
                       float64;
                     };
   timestamp: int;
   totalGritSpent: nat;
   vrfValue: nat64;
   winnerMinerId: opt MinerId;
   winnerOwner: opt principal;
 };
type BlockDetailView = 
 record {
   akkReward: nat;
   blockNumber: nat;
   minerCount: nat;
   minerGritSpent: vec record {
                         MinerId;
                         nat;
                       };
   minerParticipants: vec record {
                            MinerId;
                            principal;
                          };
   minerWeights: vec record {
                       MinerId;
                       float64;
                     };
   timestamp: int;
   totalGritSpent: nat;
   vrfValue: nat64;
   winnerMinerId: opt MinerId;
   winnerPrincipal: opt principal;
 };
type AuditLogEntry = 
 record {
   action: AuditAction;
   adminPrincipal: principal;
   chain: text;
   timestamp: int;
   tokenAddress: text;
 };
type AuditAction = 
 variant {
   add;
   remove;
 };
type AllowlistedToken = 
 record {
   chain: text;
   decimals: nat;
   name: text;
   priceUSD: float64;
   symbol: text;
   tokenAddress: text;
 };
type Account = 
 record {
   owner: principal;
   subaccount: opt blob;
 };
service : {
  addAdmin: (newAdmin: principal) -> ();
  addToken: (token: AllowlistedToken) -> ();
  claimOgBadge: () -> (variant {
                         err: text;
                         ok;
                       });
  clearAbandonedMints: () -> (variant {
                                err: text;
                                ok: nat;
                              });
  clearPendingMints: () -> (variant {
                              err: text;
                              ok: nat;
                            });
  clearTestScore: () -> (variant {
                           err: text;
                           ok;
                         });
  createMiner: (name: text, gritAmount: nat, rate: nat) ->
   (variant {
      err: text;
      ok: MinerId;
    });
  createTribe: (name: text, description: text, photoUrl: opt text,
   coverImageUrl: opt text) -> (variant {
                                  err: TribeError;
                                  ok: Tribe;
                                });
  creditAbandonedMints: () -> (variant {
                                 err: text;
                                 ok: nat;
                               });
  editMiner: (minerId: MinerId, nameChange: opt text, topUp: opt nat,
   rateChange: opt nat, pause: opt bool) -> (variant {
                                               err: text;
                                               ok;
                                             });
  editTribe: (tribeId: TribeId, name: opt text, description: opt text,
   photoUrl: opt text, coverImageUrl: opt text) ->
   (variant {
      err: TribeError;
      ok: Tribe;
    });
  execute: (qJson: text) -> (Result) query;
  getAbandonedMints: () -> (vec MintRetryView);
  getAdmins: () -> (vec principal) query;
  getAkkBalance: () -> (nat);
  getAkkLedgerCanisterId: () -> (opt principal) query;
  getAkkTransferFee: () -> (nat) query;
  getAllClaimHistory: () -> (vec ClaimRecord);
  getAllowlistAuditLog: () -> (vec AuditLogEntry);
  getAppPrincipal: () -> (principal) query;
  getBlockDetails: (blockNumber: nat) -> (opt BlockDetailView) query;
  getBlockHistory: (limit: nat) -> (vec BlockRecord) query;
  getBlockHistoryPage: (page: nat, pageSize: nat) -> (vec BlockRecord) query;
  getCurrentBlockInfo: () ->
   (record {
      blockNumber: nat;
      isMiningActive: bool;
      lastBlockTime: int;
      nextBlockIn: nat;
    }) query;
  getFeePercent: () -> (float64) query;
  getFeeRecipient: () -> (opt text) query;
  getGritIssuanceRate: () -> (nat) query;
  getHistoryBasedAk69Stockpile: () -> (float64) query;
  getIsLaunched: () -> (bool) query;
  getLaunchGate: () ->
   (record {
      enabled: bool;
      endTime: int;
      startTime: int;
    }) query;
  getLaunchGateConfig: () ->
   (record {
      endTime: int;
      launchTime: int;
      launchTimeEnabled: bool;
      nftGateEnabled: bool;
      startTime: int;
      timeWindowEnabled: bool;
    }) query;
  getLedgerMintingAccount: () -> (opt Account);
  getMinerCreationFees: () -> (vec ChainFeeEntry) query;
  getMintRetryStats: () ->
   (record {
      queueDepth: nat;
      totalAbandoned: nat;
      totalRetried: nat;
      totalSucceeded: nat;
    });
  getMyBalance: () -> (nat) query;
  getMyClaimHistory: () -> (vec ClaimRecord) query;
  getMyMiners: () -> (vec MinerView) query;
  getMyOwnedTribes: () -> (vec Tribe) query;
  getMyProfile: () -> (opt PublicProfile) query;
  getMyTribe: () -> (opt Tribe) query;
  getPendingMints: () -> (vec MintRetryView);
  getPlayerBurnSummary: ("principal": principal) ->
   (vec record {
          text;
          float64;
        }) query;
  getPlayerRank: ("principal": principal, timescale: text) -> (opt nat) query;
  getPlayerScore: ("principal": principal, timescale: text) ->
   (float64) query;
  getPlayerStreak: (p: principal) -> (nat) query;
  getPrincipalByUsername: (username: text) -> (opt principal) query;
  getProfileByUsername: (username: text) -> (opt PublicProfile) query;
  getProtocolBurnSummary: () ->
   (record {
      byToken: vec record {
                     text;
                     float64;
                     float64;
                   };
      totalBurnUsd: float64;
      totalGritFromBurns: nat;
    }) query;
  getProtocolStats: () ->
   (record {
      activeMiners: nat;
      blockReward: nat;
      blocksUntilHalving: nat;
      currentBlock: nat;
      isMiningActive: bool;
      nextBlockIn: nat;
      totalAkkMined: nat;
      totalGritSpent: nat;
      totalMiners: nat;
    }) query;
  getTestScore: () -> (opt float64) query;
  getTokens: () -> (vec AllowlistedToken) query;
  getTopPlayers: (timescale: text) -> (vec PlayerScoreEntry) query;
  getTopTribes: (timescale: text) -> (vec TribeScoreEntry) query;
  getTotalAk69Score: () -> (float64) query;
  getTotalAkkFromHistory: () -> (nat) query;
  getTotalBlockCount: () -> (nat) query;
  getTribe: (tribeId: TribeId) -> (opt Tribe) query;
  getTribeAkkFromHistory: (tribeId: TribeId) -> (nat) query;
  getTribeBurnSummary: (tribeId: text) -> (vec record {
                                                 text;
                                                 float64;
                                               }) query;
  getTribeByName: (name: text) -> (opt Tribe) query;
  getTribeLiveStats: (tribeId: TribeId) ->
   (opt record {
          memberCount: nat;
          totalAkk: nat;
          totalGrit: nat;
        }) query;
  getTribeMembers: (tribeId: TribeId) -> (vec text) query;
  getTribeMembersWithRoles: (tribeId: TribeId) ->
   (vec TribeMemberWithRole) query;
  getTribeRank: (tribeId: text, timescale: text) -> (opt nat) query;
  getTribeScore: (tribeId: text, timescale: text) -> (float64) query;
  getUserMiningStats: () ->
   (record {
      akkWon: nat;
      blocksMined: nat;
      gritSpent: nat;
    }) query;
  hasUsername: () -> (bool) query;
  initiateClaim: (txHash: text, feeTxHash: text, chain: text, tokenAddress:
   text, frontendPrice: float64) -> (variant {
                                       err: text;
                                       ok;
                                     });
  isUsernameAvailable: (username: text) -> (bool) query;
  joinTribe: (tribeId: TribeId) -> (variant {
                                      err: TribeError;
                                      ok: Tribe;
                                    });
  leaveTribe: () -> (variant {
                       err: TribeError;
                       ok;
                     });
  recheckClaimByHash: (txHash: text) -> (variant {
                                           err: text;
                                           ok: text;
                                         });
  recheckPendingClaims: () -> ();
  removeAdmin: (toRemove: principal) -> ();
  removeToken: (tokenAddress: text, chain: text) -> ();
  resetAkkLedgerCanisterId: () -> (variant {
                                     err: text;
                                     ok;
                                   });
  retryFeeClaim: (txHash: text, feeTxHash: text) ->
   (variant {
      err: text;
      ok: nat;
    });
  retryMint: (blockId: nat) -> (variant {
                                  Err: text;
                                  Ok;
                                });
  saveMyProfile: (input: ProfileInput) ->
   (variant {
      err: ProfileError;
      ok: Profile;
    });
  schema: () -> (text) query;
  searchTribes: (searchQuery: text) -> (vec Tribe) query;
  setAkkLedgerCanisterId: (id: principal) -> (variant {
                                                err: text;
                                                ok;
                                              });
  setAkkTransferFee: (fee: nat) -> (variant {
                                      err: text;
                                      ok;
                                    });
  setFeePercent: (percent: float64) -> ();
  setFeeRecipient: (address: text) -> ();
  setGritIssuanceRate: (rate: nat) -> ();
  setLaunchGate: (enabled: bool, startTime: int, endTime: int) -> ();
  setLaunchTimeGate: (enabled: bool, launchTime: int) -> ();
  setLaunched: () -> (variant {
                        err: text;
                        ok;
                      });
  setMinerCreationFee: (chain: text, feeWei: nat) ->
   (variant {
      err: text;
      ok;
    });
  setNftGate: (enabled: bool) -> ();
  setTestScore: (score: float64) -> (variant {
                                       err: text;
                                       ok;
                                     });
  transferTribeOwnership: (tribeId: TribeId, newOwnerUsername: text) ->
   (variant {
      err: TribeError;
      ok: Tribe;
    });
  transform: (input: TransformationInput) -> (TransformationOutput) query;
  transformPriceResponse: (input: TransformationInput) ->
   (TransformationOutput) query;
  transformResponse: (input: TransformationInput) ->
   (TransformationOutput) query;
  updatePlayerBadge: () -> (variant {
                              err: text;
                              ok;
                            });
  whoami: () -> (principal) query;
  withdrawAkk: (recipient: Account, amount: nat) ->
   (variant {
      err: text;
      ok: text;
    });
}
